# Copy to config/local.yaml (git-ignored) and fill in real paths.
# bagpipe.core.config loads config/local.yaml — never hardcode these paths in code.

paths:
  bids_root: /mnt/62/Bids
  qsiprep_dir: /mnt/62/Processed_Data/derivatives/qsiprep
  qsirecon_dir: /mnt/62/Processed_Data/derivatives/qsirecon
  cat12_dir: /mnt/62/Processed_Data/derivatives/tabular_cat12
  cat12_images_dir: /media/storage/yalab-dev/BIDS/derivatives/CAT12.9_2577.new  # local disk, not SMB
  legacy_demographics_csv: null  # PII-bearing CSV for the pre-SNBB (non-S####) cohort; path only
  tabular_exports_dir: /mnt/62/Processed_Data/derivatives/tabular
  id_mapping_file: null   # brainlink resolves identity; bagpipe joins via participant.uid
  db_path: /media/storage/brainlink/brainlink.db   # shared with brainlink, not copied
  mlflow_dir: /media/storage/bagpipe/outputs/mlruns
  datasets_dir: /media/storage/bagpipe/outputs/datasets
  models_dir: /media/storage/bagpipe/outputs/models
  atlas_lut_file: /home/galkepler/Projects/qsiparc/data/derivatives/qsirecon/atlases/atlas-Schaefer2018N400n7Tian2020S2/atlas-Schaefer2018N400n7Tian2020S2_dseg.tsv
  atlas_volume_file: /media/storage/bagpipe/container/atlas/schaefer2018n400n7tian2020s2.nii  # served to the results-page NiiVue viewer as the regional overlay
  cat12_apptainer_image: /media/storage/bagpipe/outputs/containers/cat12.sif  # built from container/cat12.def
  uploads_dir: /media/storage/bagpipe/outputs/uploads  # deleted per-job unless the uploader opts in via /predict's retain_uploads
  jobs_db: /media/storage/bagpipe/outputs/jobs.db  # Huey SQLite queue store

  # Custom surface atlas, computed post-hoc in Python from CAT12's own native
  # output (bagpipe.app.surface_atlas) — CAT12's own-atlas surface batch field
  # doesn't work in this build, see docs/cat12_container_spec.md §4b.
  surface_atlas_lh_annot: /media/storage/bagpipe/container/atlas/lh.schaefer2018_400p_7n.annot
  surface_atlas_rh_annot: /media/storage/bagpipe/container/atlas/rh.schaefer2018_400p_7n.annot
  surface_atlas_lh_ref_sphere: /media/storage/bagpipe/container/atlas/lh.sphere.freesurfer.gii
  surface_atlas_rh_ref_sphere: /media/storage/bagpipe/container/atlas/rh.sphere.freesurfer.gii
  yabplot_repo: null  # maintainer's own brain-plot package, not on PyPI — set to its local checkout to enable notebook brain-surface cells
  yabplot_tian_s2_atlas: null  # custom_atlas_path dir of per-region .vtk meshes matching Tian2020S2's 32 region names exactly

app:
  smtp_host: null           # e.g. smtp.resend.com — see deploy/README.md § Email
  smtp_port: 587
  smtp_user: null           # unset = plain unauthenticated relay; set = STARTTLS + login
  smtp_password: null
  from_address: null
  atlas_name: Schaefer2018N400n7Tian2020S2
  atlas_key: schaefer2018n400n7tian2020s2  # CAT12 XML element name = atlas file basename, lowercased (no __toCAT12 on CAT26)

  # Public-abuse protection (deploy/README.md § Public-abuse protection) —
  # each accepted /predict costs ~an hour of the single GPU this app runs on.
  turnstile_site_key: null    # public, embedded in the upload page's HTML
  turnstile_secret_key: null  # private, verified server-side against Cloudflare
  max_queue_depth: 5          # reject new /predict with 503 once this many jobs are pending
